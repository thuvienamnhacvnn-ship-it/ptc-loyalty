# ─────────────────────────────────────────────────────────────
# PTC Loyalty Platform — environment variables
# Copy to `.env` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon / Supabase / Railway / local)
DATABASE_URL="postgresql://user:password@localhost:5432/ptc_loyalty?schema=public"

# Auth.js — generate with: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable the Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public app URL (used for QR links, emails, absolute URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional email (optional — mocked when absent)
RESEND_API_KEY=""
EMAIL_FROM="PTC Loyalty <no-reply@ptc-loyalty.example>"

# Stripe billing (optional — billing UI works in mock mode without these)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# File upload provider key (optional)
UPLOAD_PROVIDER_KEY=""

# Secret used to sign & verify QR member tokens (HMAC). REQUIRED.
# generate with: openssl rand -base64 32
QR_SIGNING_SECRET="replace-me-with-a-long-random-string"

# Secret used to sign & verify desktop POS access tokens (HMAC). Falls back to
# AUTH_SECRET if unset, but a dedicated secret is recommended in production.
# generate with: openssl rand -base64 32
POS_JWT_SECRET="replace-me-with-a-long-random-string"

# ── WhatsApp (own number, WhatsApp Web Multi-Device) ─────────────────────────
# Every restaurant messages its customers from ITS OWN WhatsApp number: the owner
# scans a login QR once in Settings → WhatsApp. There is NO Meta Cloud API, no
# Business Verification, no Facebook Business Manager and no template approval.
#
# 32-byte key used to encrypt each restaurant's provider session key at rest
# (AES-256-GCM). generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-key"
#
# Which provider implementation to use (see src/lib/whatsapp/providers):
#   evolution = Evolution API gateway (default)
#   log       = development stub, logs instead of sending (auto-used if the
#               gateway below isn't configured)
WHATSAPP_PROVIDER="evolution"
#
# Evolution API — a self-hosted WhatsApp Web Multi-Device gateway that holds the
# long-lived session for each restaurant. Docker one-liner and docs:
#   https://doc.evolution-api.com
# It must be reachable from this app, and it must be able to reach
# NEXT_PUBLIC_APP_URL to deliver webhooks.
EVOLUTION_API_URL="https://wa.example.com"
# The gateway's global AUTHENTICATION_API_KEY (server-side only).
EVOLUTION_API_KEY=""
# Request body shape: "v2" (default, Evolution 2.x) or "v1" (Evolution 1.x).
EVOLUTION_API_VERSION="v2"
#
# The provider posts session + delivery events back to
#   POST {NEXT_PUBLIC_APP_URL}/api/whatsapp/webhook/<businessId>?secret=<per-tenant secret>
# The secret is generated per business and stored in WhatsAppConnection —
# nothing to configure here.

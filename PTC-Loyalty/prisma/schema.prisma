// ─────────────────────────────────────────────────────────────────────────────
// PTC Loyalty Platform — Prisma schema
// Multi-tenant SaaS. Every tenant-scoped table carries `businessId`.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
  BUSINESS_MANAGER
  STAFF
  CUSTOMER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum PlanTier {
  BASIC
  BUSINESS
  PREMIUM
}

// How a subscription payment reached us. Most German SME tenants pay by bank
// transfer or SEPA direct debit rather than card, so those are first-class.
enum PaymentMethod {
  BANK_TRANSFER
  SEPA_DIRECT_DEBIT
  CARD
  PAYPAL
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum TransactionType {
  EARN
  REDEEM
  BONUS
  REFUND
  ADJUSTMENT
  EXPIRE
  REFERRAL
  BIRTHDAY
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REVERSED
  FAILED
}

enum VoucherStatus {
  DRAFT
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum CustomerVoucherStatus {
  ISSUED
  REDEEMED
  EXPIRED
  CANCELLED
}

enum RewardStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  POINTS_EARNED
  REWARD_REDEEMED
  VOUCHER_NEW
  POINTS_EXPIRING
  TIER_UPGRADE_SOON
  OFFER
  BIRTHDAY
  LARGE_TRANSACTION
  FRAUD_ALERT
  SUBSCRIPTION
  SYSTEM
}

enum LoyaltyProgramType {
  SPEND_BASED
  VISIT_BASED
  BUY_X_GET_Y
  DIGITAL_STAMP
  TIER
  CASHBACK
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  QR_PENDING // login QR issued, waiting for the owner to scan it
  CONNECTING // QR scanned, provider is establishing the session
  CONNECTED
  ERROR
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppMessageKind {
  WELCOME // signup: welcome text + membership QR image
  POINTS_EARNED
  REWARD_REDEEMED
  VOUCHER
  TEST
  MANUAL // staff-composed outbound message
  INBOUND // message received FROM a customer
  APPOINTMENT // xác nhận / nhắc / huỷ lịch hẹn
  STAFF_BADGE // thẻ chấm công gửi cho nhân viên lúc nhận việc
}

// ── Auth (Auth.js compatible) ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          UserRole  @default(CUSTOMER)
  locale        String    @default("vi")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  staffProfiles    StaffProfile[]
  customerProfiles CustomerProfile[]
  ownedBusinesses  Business[]        @relation("BusinessOwner")
  auditLogs        AuditLog[]
  notifications    Notification[]
  posRefreshTokens PosRefreshToken[]
  recordedPayments Payment[]         @relation("PaymentRecordedBy")
}

// ── POS desktop client sessions ──────────────────────────────────────────────
// Long-lived refresh tokens for the Windows desktop (Electron) client. Only the
// SHA-256 hash of the opaque refresh token is stored, so a DB leak cannot mint
// sessions. Access tokens themselves are short-lived HMAC JWTs and are NOT
// stored. Rotated on every refresh; revoked on logout.
model PosRefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique // sha256(rawRefreshToken)
  businessId  String? // business resolved at issue time (informational)
  deviceLabel String? // e.g. "Kasse 1 – Pho Hanoi"
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Tenant core ──────────────────────────────────────────────────────────────

model Business {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  type         String // restaurant, cafe, nail_salon, beauty_salon, retail, ...
  email        String
  phone        String?
  addressLine  String?
  city         String?
  country      String         @default("DE")
  status       BusinessStatus @default(ACTIVE)
  ownerId      String
  currency     String         @default("EUR")
  locale       String         @default("vi")
  timezone     String         @default("Europe/Berlin")
  onboardedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  owner    User @relation("BusinessOwner", fields: [ownerId], references: [id])

  branding         BusinessBranding?
  setting          BusinessSetting?
  subscription     Subscription?
  branches         Branch[]
  staff            StaffProfile[]
  customers        CustomerProfile[]
  tiers            MembershipTier[]
  programs         LoyaltyProgram[]
  transactions     Transaction[]
  appointments     Appointment[]
  vouchers         Voucher[]
  customerVouchers CustomerVoucher[]
  rewards          Reward[]
  redemptions      RewardRedemption[]
  campaigns        Campaign[]
  notifications    Notification[]
  fraudAlerts      FraudAlert[]
  auditLogs        AuditLog[]
  invitations      Invitation[]
  memberships      CustomerMembership[]
  adjustments      TransactionAdjustment[]

  payments         Payment[]

  whatsappConnection    WhatsAppConnection?
  whatsappTemplates     WhatsAppTemplate[]
  whatsappMessages      WhatsAppMessageLog[]
  communicationConsents CustomerCommunicationConsent[]

  departments      Department[]
  shiftTemplates   ShiftTemplate[]
  shiftAssignments ShiftAssignment[]
  staffAbsences    StaffAbsence[]
  timeEntries      TimeEntry[]
  workTimeSetting  WorkTimeSetting?

  @@index([status])
}

model BusinessBranding {
  id           String   @id @default(cuid())
  businessId   String   @unique
  logoUrl      String?
  coverUrl     String?
  primaryColor String   @default("#2563eb")
  accentColor  String   @default("#f97316")
  customDomain String?  @unique
  whiteLabel   Boolean  @default(false)
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessSetting {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  // Loyalty base rule: `amountPerPoint` EUR earns `pointsPerUnit` point(s).
  amountPerPoint        Float    @default(1) // e.g. 1 -> 1€=1pt ; 10 -> 10€=1pt
  pointsPerUnit         Int      @default(1)
  rounding              String   @default("floor") // floor | round | ceil
  minPointsPerTxn       Int      @default(0)
  maxPointsPerTxn       Int?
  maxPointsPerDay       Int?
  signupBonus           Int      @default(0)
  birthdayBonus         Int      @default(0)
  referralBonus         Int      @default(0)
  pointsExpiryDays      Int? // null = never expire
  // Anti-fraud limits
  largeTxnThreshold     Int      @default(500) // points; above -> needs approval / alert
  maxTxnPerCustomerHour Int      @default(5)
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ── Billing ──────────────────────────────────────────────────────────────────

model Plan {
  id            String   @id @default(cuid())
  tier          PlanTier @unique
  name          String
  priceMonthly  Int // cents
  maxBranches   Int
  maxStaff      Int
  maxCustomers  Int
  features      String[] // feature keys enabled
  createdAt     DateTime @default(now())

  subscriptions Subscription[]
  payments      Payment[]
}

model Subscription {
  id                 String             @id @default(cuid())
  businessId         String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  stripeCustomerId   String?
  stripeSubscriptionId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([status])
}

/// A single subscription charge against a tenant.
///
/// Stripe is not wired up yet, so today every row is entered by a platform
/// admin after money actually arrives (bank transfer / SEPA). The shape is
/// deliberately Stripe-compatible: when the integration lands, webhook handlers
/// can write the same rows and fill `externalId` with the Stripe payment intent.
///
/// `amount` is in cents, like `Plan.priceMonthly`. It is snapshotted at
/// recording time rather than read from the plan, so changing a plan's price
/// never rewrites billing history.
model Payment {
  id             String        @id @default(cuid())
  businessId     String
  subscriptionId String?
  planId         String?
  amount         Int // cents
  currency       String        @default("EUR")
  method         PaymentMethod @default(BANK_TRANSFER)
  status         PaymentStatus @default(PAID)
  /// Billing period this payment covers.
  periodStart    DateTime?
  periodEnd      DateTime?
  /// Invoice number or bank reference, for reconciliation.
  reference      String?
  note           String?
  paidAt         DateTime?
  /// Payment processor id, once Stripe (or similar) is connected.
  externalId     String?
  /// Platform admin who recorded the row. Null for machine-created rows.
  recordedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  recordedBy   User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([status])
  @@index([paidAt])
}

// ── Org structure ────────────────────────────────────────────────────────────

model Branch {
  id         String   @id @default(cuid())
  businessId String
  name       String
  addressLine String?
  city       String?
  phone      String?
  openingHours String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff        StaffProfile[]
  transactions Transaction[]
  appointments Appointment[]
  shiftAssignments ShiftAssignment[]
  timeEntries      TimeEntry[]

  @@index([businessId])
}

// Người làm trong quán. CÓ HAI LOẠI, khác nhau ở chỗ có tài khoản hay không:
//
//   · Nhân viên (STAFF) — KHÔNG đăng nhập bao giờ. Danh tính là tên + số điện
//     thoại + thẻ QR. Mọi thứ họ cần biết (duyệt nghỉ, bảng công cuối tháng)
//     đến qua WhatsApp. Vì vậy `userId` để trống và `name` giữ tên thật.
//   · Chủ quán và quản lý — có tài khoản để vào dashboard, nên `userId` có giá trị.
//
// Chủ quán vẫn có một dòng ở đây vì `requireBusinessContext` dò quán qua bảng
// này, NHƯNG chủ không phải nhân viên: mọi danh sách nhân viên phải lọc bỏ
// role = BUSINESS_OWNER.
model StaffProfile {
  id            String   @id @default(cuid())
  businessId    String
  /// Rỗng với nhân viên thường — họ không có tài khoản để đăng nhập.
  userId        String?
  /// Tên hiển thị. Với người có tài khoản thì để trống và lấy theo User.name.
  name          String?
  branchId      String?
  role          UserRole @default(STAFF) // STAFF | BUSINESS_MANAGER | BUSINESS_OWNER
  pin           String? // hashed PIN for sensitive actions
  maxPointsGrant Int? // per-transaction cap for this staff member
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())

  // ── Chấm công & xếp ca ──
  /// Nonce ký thẻ chấm công. Đổi giá trị này là mọi thẻ đã in của người đó chết
  /// ngay — đó là cách xử lý khi nhân viên làm mất thẻ hoặc nghỉ việc.
  ///
  /// Giá trị do POSTGRES sinh chứ không phải Prisma, và đây là chuyện bắt buộc
  /// chứ không phải sở thích: cột này NOT NULL, mà `cuid()` thì Prisma chỉ điền
  /// lúc tạo bản ghi mới. Thêm cột kiểu đó vào bảng đã có nhân viên thật trên
  /// prod thì `prisma db push` chết vì không có gì để điền cho các dòng cũ.
  /// `gen_random_uuid()` là hàm sẵn có của Postgres 13 trở lên nên nó điền
  /// được ngay cho mọi dòng đang tồn tại.
  qrSecret      String   @default(dbgenerated("gen_random_uuid()::text"))
  /// Bộ phận chính (Küche, Bar-Service...). Xếp ca có thể ghi đè từng ca.
  departmentId  String?
  /// Mã nhân viên quán tự đặt, dùng khi xuất bảng công cho kế toán lương.
  employeeNo    String?
  /// Số điện thoại riêng của nhân viên, tách khỏi User.email vì nhiều quán
  /// dùng chung một email cho cả nhà.
  phone         String?
  /// Giờ công cam kết mỗi tuần, để bảng công so được thừa/thiếu giờ.
  weeklyHours   Float?
  /// Lương giờ tính bằng cent để tránh sai số dấu phẩy động. Chỉ chủ quán xem.
  hourlyWageCents Int?

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  appointments Appointment[]
  shiftAssignments ShiftAssignment[]
  absences         StaffAbsence[]
  timeEntries      TimeEntry[]

  @@unique([businessId, userId])
  @@unique([businessId, employeeNo])
  @@index([businessId])
}

// ── Customers & membership ───────────────────────────────────────────────────

model CustomerProfile {
  id               String   @id @default(cuid())
  businessId       String
  userId           String?
  memberCode       String // human-facing membership number, unique per business
  qrSecret         String   @default(cuid()) // per-member secret rotated on demand
  firstName        String
  lastName         String?
  email            String?
  phone            String?
  birthDate        DateTime?
  gender           String?
  locale           String   @default("vi")
  pointsBalance    Int      @default(0)
  totalEarned      Int      @default(0)
  totalRedeemed    Int      @default(0)
  visitCount       Int      @default(0)
  marketingConsent Boolean  @default(false)
  isBlocked        Boolean  @default(false)
  isAnonymized     Boolean  @default(false)
  joinedAt         DateTime @default(now())
  lastVisitAt      DateTime?
  lastReengagedAt  DateTime? // last win-back email sent (dedup per inactivity episode)
  lastBirthdayGreetingAt DateTime? // last birthday greeting sent (dedup per year)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business         Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user             User?                @relation(fields: [userId], references: [id])
  membership       CustomerMembership?
  transactions     Transaction[]
  appointments     Appointment[]
  customerVouchers CustomerVoucher[]
  redemptions      RewardRedemption[]
  campaignTargets  CampaignRecipient[]
  communicationConsent CustomerCommunicationConsent?
  whatsappMessages     WhatsAppMessageLog[]

  @@unique([businessId, memberCode])
  // Anti-duplicate: one phone / one email per business (NULLs are allowed and
  // do not conflict — customers without a phone/email are fine).
  @@unique([businessId, phone])
  @@unique([businessId, email])
  @@index([businessId])
}

model MembershipTier {
  id            String   @id @default(cuid())
  businessId    String
  name          String // Bronze / Silver / Gold / Platinum (renamable)
  level         Int // ordering: 1,2,3,4
  minPoints     Int // lifetime points threshold to reach this tier
  pointsMultiplier Float @default(1.0)
  color         String   @default("#a16207")
  perks         String?
  retentionDays Int? // how long tier is retained
  createdAt     DateTime @default(now())

  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships CustomerMembership[]

  @@unique([businessId, level])
  @@index([businessId])
}

model CustomerMembership {
  id         String           @id @default(cuid())
  businessId String
  customerId String           @unique
  tierId     String
  status     MembershipStatus @default(ACTIVE)
  since      DateTime         @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tier     MembershipTier  @relation(fields: [tierId], references: [id])

  @@index([businessId])
}

// ── Loyalty program config ───────────────────────────────────────────────────

model LoyaltyProgram {
  id         String             @id @default(cuid())
  businessId String
  name       String
  type       LoyaltyProgramType @default(SPEND_BASED)
  isActive   Boolean            @default(true)
  config     Json? // flexible per-type config (stamps needed, X/Y, etc.)
  branchId   String? // null = all branches
  createdAt  DateTime           @default(now())

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rules    LoyaltyRule[]

  @@index([businessId])
}

model LoyaltyRule {
  id         String   @id @default(cuid())
  programId  String
  name       String
  kind       String // signup | birthday | referral | product | double_points | time_window
  value      Int      @default(0)
  config     Json?
  isActive   Boolean  @default(true)

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

// ── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id             String            @id @default(cuid())
  businessId     String
  branchId       String?
  customerId     String
  staffId        String?
  type           TransactionType
  status         TransactionStatus @default(COMPLETED)
  amount         Float? // invoice amount in EUR (for EARN)
  points         Int // signed: + for earn/bonus, - for redeem
  balanceBefore  Int
  balanceAfter   Int
  voucherId      String?
  idempotencyKey String? // prevents double-submit
  receiptRef     String? // invoice/receipt id; an invoice can be used once
  note           String?
  device         String?
  ipAddress      String?
  createdAt      DateTime          @default(now())

  business    Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?                 @relation(fields: [branchId], references: [id])
  customer    CustomerProfile         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff       StaffProfile?           @relation(fields: [staffId], references: [id])
  adjustments TransactionAdjustment[]

  @@unique([businessId, idempotencyKey])
  @@unique([businessId, receiptRef])
  @@index([businessId, createdAt])
  @@index([businessId, customerId])
  @@index([businessId, branchId])
  @@index([businessId, staffId])
}

model TransactionAdjustment {
  id            String   @id @default(cuid())
  businessId    String
  transactionId String
  reason        String
  pointsDelta   Int
  performedById String // user id (manager/owner)
  createdAt     DateTime @default(now())

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([transactionId])
}

// ── Vouchers ─────────────────────────────────────────────────────────────────

model Voucher {
  id             String        @id @default(cuid())
  businessId     String
  code           String
  title          String
  description    String?
  discountType   String        @default("percent") // percent | fixed | free_item
  discountValue  Float         @default(0)
  pointsCost     Int           @default(0)
  quantity       Int? // null = unlimited
  issuedCount    Int           @default(0)
  perCustomerLimit Int         @default(1)
  branchId       String? // null = all branches
  requiredTierId String?
  startsAt       DateTime?
  expiresAt      DateTime?
  status         VoucherStatus @default(DRAFT)
  autoBirthday   Boolean       @default(false)
  createdAt      DateTime      @default(now())

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerVouchers CustomerVoucher[]

  @@unique([businessId, code])
  @@index([businessId, status])
}

model CustomerVoucher {
  id         String                @id @default(cuid())
  businessId String
  voucherId  String
  customerId String
  status     CustomerVoucherStatus @default(ISSUED)
  code       String                @unique // unique claim code
  issuedAt   DateTime              @default(now())
  redeemedAt DateTime?
  expiresAt  DateTime?

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  voucher  Voucher         @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([customerId])
}

// ── Rewards catalog ──────────────────────────────────────────────────────────

model Reward {
  id          String       @id @default(cuid())
  businessId  String
  name        String
  description String?
  imageUrl    String?
  pointsCost  Int
  stock       Int? // null = unlimited
  redeemLimit Int? // per customer
  branchId    String?
  expiresAt   DateTime?
  status      RewardStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  redemptions RewardRedemption[]

  @@index([businessId, status])
}

model RewardRedemption {
  id         String           @id @default(cuid())
  businessId String
  rewardId   String
  customerId String
  pointsSpent Int
  status     RedemptionStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reward   Reward          @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([customerId])
}

// ── Marketing ────────────────────────────────────────────────────────────────

model Campaign {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  subject     String?
  body        String?
  audience    Json? // filter definition
  channel     String         @default("email") // email | inapp
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  openCount   Int            @default(0)
  redeemCount Int            @default(0)
  createdAt   DateTime       @default(now())

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([businessId, status])
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  customerId String
  sentAt     DateTime?
  openedAt   DateTime?

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
}

// ── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  businessId String?
  userId     String?
  type       NotificationType
  title      String
  body       String?
  data       Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([businessId])
}

// ── Anti-fraud & audit ───────────────────────────────────────────────────────

model FraudAlert {
  id          String         @id @default(cuid())
  businessId  String
  level       FraudRiskLevel @default(LOW)
  kind        String // rapid_txn | large_txn | self_grant | reused_receipt | ...
  description String
  metadata    Json?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, level])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id])

  @@index([businessId, createdAt])
}

model Invitation {
  id         String           @id @default(cuid())
  businessId String
  email      String
  role       UserRole         @default(STAFF)
  branchId   String?
  token      String           @unique
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model SupportTicket {
  id         String              @id @default(cuid())
  businessId String?
  subject    String
  body       String
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([status])
}

enum AppointmentStatus {
  BOOKED // đã đặt, chưa xác nhận lại
  CONFIRMED // khách đã xác nhận
  DONE // khách đã tới và làm xong
  NO_SHOW // hẹn rồi nhưng không tới
  CANCELLED
}

// Lịch hẹn (Termin). Bản đầu tiên CỐ Ý giữ đơn giản: nhân viên nhập giờ tay,
// dịch vụ là một dòng chữ tự do. Chưa có danh mục dịch vụ kèm thời lượng và
// chưa có giờ làm của từng thợ, nên hệ thống KHÔNG tự tính khung giờ trống —
// nó chỉ cảnh báo khi hai lịch của cùng một thợ đè lên nhau.
//
// Khác hẳn bảng lượt ghé trên thẻ thành viên: bảng đó là quá khứ (Transaction),
// còn đây là tương lai.
model Appointment {
  id         String            @id @default(cuid())
  businessId String
  branchId   String?
  customerId String
  staffId    String? // Bediener; null = quán tự phân công sau
  startAt    DateTime
  durationMin Int              @default(60)
  service    String? // "Neumodellage", "Auffüllen"... — chữ tự do ở bản này
  note       String?
  status     AppointmentStatus @default(BOOKED)
  createdById String? // User đã tạo lịch, để truy trách nhiệm

  // Mốc đã nhắn gì rồi, để cron không gửi trùng.
  confirmSentAt    DateTime?
  reminder24SentAt DateTime?
  reminder2SentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?         @relation(fields: [branchId], references: [id])
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    StaffProfile?   @relation(fields: [staffId], references: [id])

  @@index([businessId, startAt])
  @@index([businessId, status, startAt])
  @@index([customerId, startAt])
  @@index([staffId, startAt])
  // Cron quét theo mốc thời gian nên cần chỉ mục riêng cho startAt.
  @@index([startAt])
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

// Tin nhắn gửi từ form Liên hệ ngoài trang công khai. Người gửi là khách vãng
// lai (không có tài khoản, không thuộc doanh nghiệp nào) nên KHÔNG dùng chung
// SupportTicket — chỗ đó dành cho yêu cầu của các quán đã đăng ký.
//
// Tin luôn được ghi vào bảng này TRƯỚC rồi mới gửi email báo; email hỏng cũng
// không làm mất tin, admin vẫn đọc được ở /admin/contact.
model ContactMessage {
  id         String               @id @default(cuid())
  name       String
  email      String
  message    String
  status     ContactMessageStatus @default(NEW)
  ip         String?
  userAgent  String?
  emailSent  Boolean              @default(false)
  emailError String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([ip, createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Brute-force protection for login: counts failed attempts per key (email/IP)
// within a rolling window, and blocks until `blockedUntil`.
model LoginAttempt {
  id           String    @id @default(cuid())
  key          String    @unique // e.g. "login:owner@pho-hanoi.de"
  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([blockedUntil])
}

// ── WhatsApp (own number, WhatsApp Web Multi-Device via a swappable provider) ─
// Every business messages its customers from ITS OWN WhatsApp number: the owner
// scans a login QR once and the provider (Evolution API by default — see
// src/lib/whatsapp/providers) keeps that Web-MD session alive. There is no Meta
// Cloud API, no Business Verification and no template approval anywhere here.
//
// All rows are tenant-scoped by `businessId`. The provider's per-session API key
// is stored ONLY as AES-256-GCM ciphertext (src/lib/crypto.ts).

model WhatsAppConnection {
  id                  String                   @id @default(cuid())
  businessId          String                   @unique
  status              WhatsAppConnectionStatus @default(DISCONNECTED)
  provider            String                   @default("evolution") // provider id — see providers/index.ts
  instanceId          String?                  @unique // provider-side session name
  instanceTokenCipher String? // AES-256-GCM "iv:tag:cipher" — NEVER sent to client
  displayPhoneNumber  String? // the restaurant's OWN WhatsApp number, as reported after pairing
  profileName         String? // WhatsApp profile name of that number
  // Transient login QR (data URL) shown in Settings while status = QR_PENDING.
  lastQr              String?
  lastQrAt            DateTime?
  webhookSecret       String? // shared secret in the provider callback URL
  defaultLanguage     String                   @default("vi")
  // Per-event opt-out toggles controlled by the business.
  notifyOnSignup      Boolean                  @default(true)
  notifyOnEarn        Boolean                  @default(true)
  notifyOnRedeem      Boolean                  @default(true)
  notifyOnVoucher     Boolean                  @default(true)
  lastError           String?
  connectedAt         DateTime?
  lastSeenAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// Per-business message copy. Free-form text — nothing is submitted to or
// approved by anyone; `body` uses {{1}}, {{2}}, … positional placeholders.
model WhatsAppTemplate {
  id         String   @id @default(cuid())
  businessId String
  key        String // welcome | points_earned | reward_redeemed | voucher
  language   String // vi | de | en
  body       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key, language])
  @@index([businessId])
}

model WhatsAppMessageLog {
  id                String                @id @default(cuid())
  businessId        String
  customerId        String?
  kind              WhatsAppMessageKind
  status            WhatsAppMessageStatus @default(QUEUED)
  direction         String                @default("OUTBOUND") // OUTBOUND | INBOUND
  toPhone           String
  fromPhone         String? // sender number for INBOUND messages
  language          String                @default("vi")
  templateKey       String?
  idempotencyKey    String // prevents duplicate sends
  providerMessageId String? // message id returned by the WhatsApp provider
  transactionId     String?
  payloadSnapshot   Json? // variables sent (for audit/preview)
  error             String?
  attempts          Int                   @default(0)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, customerId])
  @@index([providerMessageId])
}

model CustomerCommunicationConsent {
  id                     String    @id @default(cuid())
  businessId             String
  customerId             String    @unique
  whatsappPhone          String? // E.164 override; falls back to customer.phone
  // Transactional consent (points/redeem/voucher notices) is kept SEPARATE
  // from marketing consent, per GDPR / WhatsApp policy.
  whatsappTransactional  Boolean   @default(false)
  whatsappMarketing      Boolean   @default(false)
  transactionalConsentAt DateTime?
  marketingConsentAt     DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Quản lý thời gian làm việc (Arbeitszeit)
//
// Ba khối tách bạch, đừng trộn vào nhau:
//   1. KẾ HOẠCH  — ShiftTemplate + ShiftAssignment: quán ĐỊNH xếp ai làm ca nào.
//   2. THỰC TẾ   — TimeEntry: nhân viên THỰC SỰ quét QR vào/ra lúc mấy giờ.
//   3. VẮNG MẶT  — StaffAbsence: báo ốm/nghỉ phép, chặn không cho xếp ca.
// Bảng công (Lohn) là phép so khối 2 với khối 1; sai lệch chính là cái quán
// cần nhìn: đi muộn, về sớm, quên quét ra.
//
// Giờ trong ca lưu bằng SỐ PHÚT TỪ NỬA ĐÊM theo giờ địa phương của quán, không
// phải DateTime. Lý do: "ca sáng 08:00–16:00" là một quy tắc lặp lại; gắn nó
// vào một mốc UTC cụ thể thì mỗi lần đổi giờ mùa hè/mùa đông (Sommerzeit) lịch
// sẽ tự lệch một tiếng. Còn TimeEntry thì ngược lại — đó là một khoảnh khắc có
// thật nên vẫn là DateTime UTC.
// ─────────────────────────────────────────────────────────────────────────────

enum AbsenceType {
  SICK // báo ốm (Krankmeldung)
  VACATION // nghỉ phép (Urlaub)
  UNPAID // nghỉ không lương
  TRAINING // đi học, đào tạo
  OTHER
}

enum AbsenceStatus {
  REQUESTED // nhân viên tự báo, chờ quản lý duyệt
  APPROVED // đã duyệt — CHẶN xếp ca trong khoảng này
  REJECTED
  CANCELLED
}

enum ShiftAssignmentStatus {
  PLANNED // đã xếp, chưa chốt
  CONFIRMED // quản lý đã chốt hoặc nhân viên đã xác nhận
  CANCELLED
}

enum TimeEntrySource {
  QR // nhân viên quét thẻ ở máy chấm công — đường đi chuẩn
  MANUAL // quản lý nhập hoặc sửa tay (luôn ghi lại ai sửa)
  AUTO_CLOSE // hệ thống tự đóng vì quên quét ra
}

/// Bộ phận trong quán — với quán ăn là Küche, Bar-Service, Service...
/// Tiệm nail thường không dùng, nên danh sách rỗng vẫn là hợp lệ.
model Department {
  id         String   @id @default(cuid())
  businessId String
  name       String
  colorHex   String   @default("#145DFF")
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff       StaffProfile[]
  templates   ShiftTemplate[]
  assignments ShiftAssignment[]
  timeEntries TimeEntry[]

  @@unique([businessId, name])
  @@index([businessId])
}

/// Khuôn ca lặp lại: "Ca sáng 08:00–16:00, nghỉ 30 phút".
model ShiftTemplate {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  startMinute  Int // phút từ nửa đêm, giờ quán. 08:00 = 480
  endMinute    Int // 16:00 = 960. Nhỏ hơn hoặc bằng start nghĩa là ca qua đêm.
  breakMin     Int      @default(0)
  departmentId String? // ca chỉ dành cho một bộ phận; null = bộ phận nào cũng được
  colorHex     String   @default("#145DFF")
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  department  Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments ShiftAssignment[]

  @@unique([businessId, name])
  @@index([businessId])
}

/// Một ô trong bảng xếp ca: nhân viên X, ngày Y, từ mấy giờ tới mấy giờ.
/// Giờ được CHÉP từ khuôn ca lúc xếp chứ không đọc qua quan hệ — sửa khuôn ca
/// cho tháng sau không được phép làm đổi lịch đã xếp và đã làm của tháng trước.
model ShiftAssignment {
  id              String                @id @default(cuid())
  businessId      String
  branchId        String?
  staffId         String
  departmentId    String?
  shiftTemplateId String? // nguồn gốc, giữ để hiển thị tên ca
  date            DateTime              @db.Date // ngày làm việc theo lịch quán
  startMinute     Int
  endMinute       Int
  breakMin        Int                   @default(0)
  note            String?
  status          ShiftAssignmentStatus @default(PLANNED)
  createdById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch?        @relation(fields: [branchId], references: [id])
  staff       StaffProfile   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  department  Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  template    ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  // Một người không thể có hai ca bắt đầu cùng lúc trong cùng một ngày.
  @@unique([staffId, date, startMinute])
  @@index([businessId, date])
  @@index([staffId, date])
}

/// Báo ốm hoặc nghỉ phép. Khoảng ngày tính cả startDate lẫn endDate.
model StaffAbsence {
  id             String        @id @default(cuid())
  businessId     String
  staffId        String
  type           AbsenceType   @default(SICK)
  status         AbsenceStatus @default(REQUESTED)
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  note           String?
  /// Có giấy bác sĩ (AU-Bescheinigung) chưa — ở Đức từ ngày ốm thứ 3 là bắt buộc.
  hasCertificate Boolean       @default(false)
  reportedById   String? // User đã tạo: nhân viên tự báo hoặc quản lý nhập hộ
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, startDate])
  @@index([staffId, startDate])
  @@index([businessId, status])
}

/// Một lần chấm công có thật. clockOutAt còn null nghĩa là đang trong ca.
model TimeEntry {
  id                String          @id @default(cuid())
  businessId        String
  branchId          String?
  staffId           String
  departmentId      String?
  shiftAssignmentId String? // ca đã xếp mà lần quét này khớp vào, nếu có
  clockInAt         DateTime
  clockOutAt        DateTime?
  breakMin          Int             @default(0)
  source            TimeEntrySource @default(QR)
  note              String?
  /// Đi muộn và về sớm so với ca đã xếp, tính bằng phút (0 nếu không xếp ca).
  lateMin           Int             @default(0)
  earlyLeaveMin     Int             @default(0)
  /// Hệ thống tự đóng vì quên quét ra, nên số giờ KHÔNG đáng tin, phải sửa tay.
  autoClosed        Boolean         @default(false)
  editedById        String?
  editedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch?          @relation(fields: [branchId], references: [id])
  staff      StaffProfile     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  department Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignment ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id], onDelete: SetNull)

  @@index([businessId, clockInAt])
  @@index([staffId, clockInAt])
  // Máy chấm công hỏi "người này có đang mở ca nào không" ở MỌI lần quét.
  @@index([staffId, clockOutAt])
}

/// Quy tắc chấm công của từng quán. Mặc định lấy theo luật giờ làm việc Đức
/// (ArbZG): nghỉ 30 phút khi làm trên 6 tiếng, 45 phút khi trên 9 tiếng, trần
/// 10 tiếng một ngày, nghỉ 11 tiếng giữa hai ca.
model WorkTimeSetting {
  id         String @id @default(cuid())
  businessId String @unique

  /// Quét sớm hoặc muộn trong khoảng này thì vẫn coi là đúng giờ.
  toleranceMin    Int     @default(10)
  /// Quá số giờ này mà chưa quét ra thì cron tự đóng và gắn cờ.
  autoCloseHours  Int     @default(14)
  /// Làm tròn giờ công theo bội số phút này (0 = không làm tròn).
  roundingMin     Int     @default(0)
  /// Tự trừ giờ nghỉ theo luật ngay cả khi nhân viên không bấm nghỉ.
  autoDeductBreak Boolean @default(true)
  breakAfter6h    Int     @default(30)
  breakAfter9h    Int     @default(45)
  maxDailyHours   Float   @default(10)
  minRestHours    Float   @default(11)
  /// Chặn quét lặp trong ngần này giây, tránh bấm hai lần thành vào rồi ra ngay.
  scanCooldownSec Int     @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
